# 企画ブリーフ — 要件定義の前に、伝えたいことを一度にまとめて書くファイル
#
# schema: harness/schemas/brief.schema.json
#
# 使い方:
#   1. 分かるところだけ埋める。**空欄のままで構いません**（空欄は要件定義の対話で必ず聞かれます）。
#   2. `python3 harness/scripts/check_brief.py {{BRIEF_PATH}}` で書式と未記入項目を確認する。
#   3. `init-app` skill を起動する。このファイルが自動で読み込まれ、要件定義の出発点になります。
#
# 書き方の約束:
#   - ここに書いたことは**そのまま要件として扱われます**。断定できないことは `open_points` に書いてください。
#   - 「どう作るか（実装方法）」ではなく「何ができてほしいか」を書きます。技術の希望は `tech:` に書きます。
#   - 迷ったら空欄にしてください。空欄は勝手に補完されず、対話で確認されます。

brief_version: 1

app_id: "{{APP_ID}}"
app_name: "{{APP_NAME}}"
author: ""            # 記入した人（要件の承認者になる人）
created_at: "{{TIMESTAMP}}"

# ── 何のためのアプリか ───────────────────────────────────────────────
# 解決したい課題。「誰の」「どんな不便を」「どうしたいか」の3点が入っていると誤解が起きません。
purpose: |

# 今どうしているか、なぜ今それを作るのか（任意）
background: |

# 想定ユーザー。役割と利用場面をセットで（例: "現場の作業員。スマホで屋外から入力する"）
target_users: []

# 達成したいこと（このアプリで実現したい状態）
goals: []

# あえてやらないこと。ここが効くほど設計がぶれません（例: "権限管理は当面しない"）
non_goals: []

# ── 必要な機能 ───────────────────────────────────────────────────────
# 必須の機能。acceptance（受け入れ基準）は「この条件を満たせば完成と言える」を検証可能な形で。
# acceptance は要件定義でそのまま受け入れ基準になり、テストと機械的に突き合わされます。
must_features: []
# 例:
# must_features:
#   - title: "備品の貸出登録"
#     detail: "誰がいつ何を借りたかを記録する"
#     acceptance: "貸出を登録すると、一覧に借用者名と日時が表示される"

# あると嬉しい機能（優先度は落ちる。要件では SHOULD / COULD になります）
nice_to_have: []
# 例:
# nice_to_have:
#   - title: "CSV エクスポート"
#     detail: "月次の棚卸しで使う"

# ── 使ってほしい技術 ─────────────────────────────────────────────────
tech:
  preferred: []        # 使ってほしい言語・フレームワーク・DB など（例: ["TypeScript", "React", "SQLite"]）
  forbidden: []        # 使ってほしくないもの（例: ["有償ライセンスのライブラリ"]）
  reasons: ""          # そう指定する理由（保守する人のスキル・社内標準・既存資産との整合など）
  existing_assets: ""  # 流用したい既存コード・API・スキーマがあれば

# ── 見た目・操作の形 ─────────────────────────────────────────────────
ui:
  form: ""             # CLI / Web / デスクトップ / モバイル / API のみ / バッチ / UI なし など
  notes: ""            # 操作の好み、画面の雰囲気、アクセシビリティの要求など
  references: []       # 参考にしたい既存アプリ・画面の説明

# ── 扱うデータ ───────────────────────────────────────────────────────
data:
  handles: []               # 何を保存・処理するか（例: ["備品マスタ", "貸出履歴"]）
  persistence: ""           # 永続化の要否（必要 / 不要 / 未定）
  personal_information: ""  # 個人情報・機微情報の有無（あり / なし / 未定）。セキュリティ要件の分岐点です
  volume: ""                # 想定件数・データ量

# ── 外部サービス連携 ─────────────────────────────────────────────────
integrations: []
# 例:
# integrations:
#   - name: "Slack"
#     purpose: "返却期限の通知を送る"
#     credentials: "Webhook URL を用意できる"

# ── 動かす環境 ───────────────────────────────────────────────────────
environment:
  runtime: ""      # 実行環境（Windows / macOS / Linux / ブラウザ / 社内サーバ など）
  deployment: ""   # どこにどう置くか（ローカル実行 / 社内サーバ / クラウド / 未定）
  offline: ""      # オフラインで動く必要があるか
  users_scale: ""  # 同時に使う人数・想定利用規模

# ── 品質・制約 ───────────────────────────────────────────────────────
non_functional_requirements: []
# 例:
# non_functional_requirements:
#   - category: "性能"
#     description: "一覧表示は 1 秒以内"
#   - category: "セキュリティ"
#     description: "社内ネットワークからのみアクセスできればよい"

constraints: []           # 期限・予算・ライセンス・組織上の制約など
acceptance_overall: []    # アプリ全体として「これができたら完成」と言える条件

# 自動化の度合いの希望（MANUAL / SUPERVISED / AUTONOMOUS。空なら init-app が対話で確認します）
# ※ どのモードでも、要件定義の承認だけは必ず人間が行います。
autonomy_mode: ""

# 参考資料（既存ドキュメント・画面キャプチャ・仕様書などの場所）
references: []
# 例:
# references:
#   - label: "現行の管理台帳"
#     url: "./docs/genkou-daichou.xlsx"
#     note: "列の定義を踏襲したい"

# ── 決めきれていないこと ─────────────────────────────────────────────
# 自分でも迷っている点。ここに書いたものは要件定義の対話で**優先的に**扱われます。
open_points: []

# その他、伝えておきたいこと
notes: |
