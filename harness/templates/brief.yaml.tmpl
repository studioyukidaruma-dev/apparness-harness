# 企画ブリーフ — 要件定義の前に、伝えたいことを一度にまとめて書くファイル
#
# schema: harness/schemas/brief.schema.json
#
# 使い方:
#   1. 分かるところだけ書く。**空欄のままで構いません**（空欄は要件定義の対話で必ず聞かれます）。
#   2. `python3 harness/scripts/check_brief.py {{BRIEF_PATH}}` で書式と未記入項目を確認する。
#   3. `init-app` skill を起動する。このファイルが自動で読み込まれ、要件定義の出発点になります。
#
# ── 書き方（記号の扱い） ─────────────────────────────────────────────
#   - 項目名（`purpose:` のようにコロンで終わる語）は**消さないでください**。消すと空欄と同じ扱いです。
#   - `#` から行末までは説明です。残しても消しても構いません。
#   - 空欄は「コロンの後に何もない」状態です。記号を足したり消したりする必要はありません。
#   - 書き方は次の 4 通りだけです。各項目の上にある「書き方の例」と同じ形で書いてください。
#
#     (1) 短い値 … コロンの後に空白を 1 つ置いて、同じ行に書く
#           form: Web
#
#     (2) 文章 … 項目名の次の行から、行頭に空白を 2 つ入れて書く（何行でもよい）
#           purpose:
#             総務部の備品の貸出を Excel で管理していて、返却漏れに気づけない。
#
#     (3) 箇条書き … 項目名の次の行から、行頭に「空白 2 つ・ハイフン・空白」を入れて 1 行に 1 つずつ書く
#           goals:
#             - 貸出状況をその場で確認できる
#             - 返却期限を過ぎたら気づける
#
#     (4) まとまり … 機能のように複数の欄を持つものは、1 つを「- title:」などで始め、
#                    残りの欄を title と同じ位置まで字下げして書く（増やすときはまとまりを繰り返す）
#           must_features:
#             - title: 備品の貸出登録
#               acceptance: 貸出を登録すると、一覧に借用者名と日時が表示される
#
#   - 字下げには空白を使います（タブは使えません）。同じ項目の中では字下げの幅を揃えてください。
#   - 文中に半角の「: 」（コロンと空白）を書くと読み取りに失敗し、半角の「 #」（空白とシャープ）を書くとそこから後ろが
#     説明とみなされて消えます。文中では全角の「：」「＃」を使ってください。
#
# 書く内容の約束:
#   - ここに書いたことは**そのまま要件として扱われます**。断定できないことは `open_points` に書いてください。
#   - 「どう作るか（実装方法）」ではなく「何ができてほしいか」を書きます。技術の希望は `tech` に書きます。
#   - 迷ったら空欄にしてください。空欄は勝手に補完されず、対話で確認されます。

brief_version: 1   # この行は変更しないでください

app_id: "{{APP_ID}}"
app_name: "{{APP_NAME}}"
author:              # 記入した人（要件の承認者になる人）
created_at: "{{TIMESTAMP}}"

# ── 何のためのアプリか ───────────────────────────────────────────────
# 解決したい課題。「誰の」「どんな不便を」「どうしたいか」の3点が入っていると誤解が起きません。
# 書き方の例:
#   purpose:
#     総務部の備品の貸出を Excel で管理していて、返却漏れに気づけない。
#     誰が何を借りているかをその場で確認できるようにしたい。
purpose:

# 今どうしているか、なぜ今それを作るのか（任意）
# 書き方の例:
#   background:
#     共有フォルダの Excel に手で追記している。同時に開くと上書きされる事故が月に数回ある。
background:

# 想定ユーザー。役割と利用場面をセットで、1 行に 1 種類ずつ。
# 書き方の例:
#   target_users:
#     - 総務担当。自席の PC で貸出と返却を登録する
#     - 一般社員。借りたいときに空きを確認する
target_users:

# 達成したいこと（このアプリで実現したい状態）
# 書き方の例:
#   goals:
#     - 貸出状況をその場で確認できる
#     - 返却期限を過ぎた貸出に気づける
goals:

# あえてやらないこと。ここが効くほど設計がぶれません。
# 書き方の例:
#   non_goals:
#     - 権限管理は当面しない
non_goals:

# ── 必要な機能 ───────────────────────────────────────────────────────
# 必須の機能。1 つの機能を「- title:」で始め、その下に detail（説明）と acceptance（受け入れ基準）を
# title と同じ位置まで字下げして書きます。機能を増やすときは、このまとまりを繰り返します。
# acceptance は「この条件を満たせば完成と言える」を検証可能な形で。要件定義でそのまま受け入れ基準になり、
# テストと機械的に突き合わされます。
# 書き方の例:
#   must_features:
#     - title: 備品の貸出登録
#       detail: 誰がいつ何を借りたかを記録する
#       acceptance: 貸出を登録すると、一覧に借用者名と日時が表示される
#     - title: 返却登録
#       detail: 返却された備品を貸出中から外す
#       acceptance: 返却を登録すると、その備品が一覧で「貸出可」に戻る
must_features:

# あると嬉しい機能（優先度は落ちる。要件では SHOULD / COULD になります）
# 書き方の例:
#   nice_to_have:
#     - title: CSV エクスポート
#       detail: 月次の棚卸しで使う
nice_to_have:

# ── 使ってほしい技術 ─────────────────────────────────────────────────
# 下の 4 項目は、行頭に空白を 2 つ入れた位置のまま書きます（箇条書きなら空白 4 つ・ハイフン・空白）。
# 書き方の例:
#   tech:
#     preferred:
#       - TypeScript
#       - SQLite
#     forbidden:
#       - 有償ライセンスのライブラリ
#     reasons: 保守担当が TypeScript しか書けないため
tech:
  preferred:         # 使ってほしい言語・フレームワーク・DB など（箇条書き）
  forbidden:         # 使ってほしくないもの（箇条書き）
  reasons:           # そう指定する理由（保守する人のスキル・社内標準・既存資産との整合など）
  existing_assets:   # 流用したい既存コード・API・スキーマがあれば

# ── 見た目・操作の形 ─────────────────────────────────────────────────
# 書き方の例:
#   ui:
#     form: Web
#     notes: スマホでも崩れずに操作できること
#     references:
#       - 社内の会議室予約システムの一覧画面
ui:
  form:              # CLI / Web / デスクトップ / モバイル / API のみ / バッチ / UI なし など
  notes:             # 操作の好み、画面の雰囲気、アクセシビリティの要求など
  references:        # 参考にしたい既存アプリ・画面の説明（箇条書き）

# ── 扱うデータ ───────────────────────────────────────────────────────
# 書き方の例:
#   data:
#     handles:
#       - 備品マスタ
#       - 貸出履歴
#     persistence: 必要
#     personal_information: あり
#     volume: 備品 300 件、貸出は年 2000 件ほど
data:
  handles:                # 何を保存・処理するか（箇条書き）
  persistence:            # 永続化の要否（必要 / 不要 / 未定）
  personal_information:   # 個人情報・機微情報の有無（あり / なし / 未定）。セキュリティ要件の分岐点です
  volume:                 # 想定件数・データ量

# ── 外部サービス連携 ─────────────────────────────────────────────────
# 1 つの連携を「- name:」で始め、その下に purpose（目的）と credentials（認証情報）を書きます。
# 書き方の例:
#   integrations:
#     - name: Slack
#       purpose: 返却期限の通知を送る
#       credentials: Webhook URL を用意できる
integrations:

# ── 動かす環境 ───────────────────────────────────────────────────────
# 書き方の例:
#   environment:
#     runtime: ブラウザ
#     deployment: 社内サーバ
#     offline: 不要
#     users_scale: 同時に 10 人程度
environment:
  runtime:           # 実行環境（Windows / macOS / Linux / ブラウザ / 社内サーバ など）
  deployment:        # どこにどう置くか（ローカル実行 / 社内サーバ / クラウド / 未定）
  offline:           # オフラインで動く必要があるか
  users_scale:       # 同時に使う人数・想定利用規模

# ── 品質・制約 ───────────────────────────────────────────────────────
# 性能・セキュリティなどの要求。1 つを「- category:」で始め、その下に description を書きます。
# 書き方の例:
#   non_functional_requirements:
#     - category: 性能
#       description: 一覧表示は 1 秒以内
#     - category: セキュリティ
#       description: 社内ネットワークからのみアクセスできればよい
non_functional_requirements:

# 期限・予算・ライセンス・組織上の制約など
# 書き方の例:
#   constraints:
#     - 来年 4 月の年度切り替えまでに使い始めたい
constraints:

# アプリ全体として「これができたら完成」と言える条件
# 書き方の例:
#   acceptance_overall:
#     - 総務担当が Excel を開かずに 1 か月の貸出業務を回せる
acceptance_overall:

# 自動化の度合いの希望。MANUAL / SUPERVISED / AUTONOMOUS のどれか 1 つを書きます
# （空なら init-app が対話で確認します）。
# ※ どのモードでも、要件定義の承認だけは必ず人間が行います。
# 書き方の例:
#   autonomy_mode: SUPERVISED
autonomy_mode:

# 参考資料（既存ドキュメント・画面キャプチャ・仕様書などの場所）
# 1 つを「- label:」で始め、その下に url（場所）と note（補足）を書きます。
# 書き方の例:
#   references:
#     - label: 現行の管理台帳
#       url: ./docs/genkou-daichou.xlsx
#       note: 列の定義を踏襲したい
references:

# ── 決めきれていないこと ─────────────────────────────────────────────
# 自分でも迷っている点。ここに書いたものは要件定義の対話で**優先的に**扱われます。
# 書き方の例:
#   open_points:
#     - 返却期限を備品ごとに変えるべきか迷っている
open_points:

# その他、伝えておきたいこと
# 書き方の例:
#   notes:
#     4 月以降は人事部でも同じ仕組みを使うかもしれない。
notes:
