{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparness.local/schemas/requirements.schema.json",
  "title": "Requirements",
  "description": "apps/<app-id>/00-requirements/requirements.machine.yaml の検証スキーマ。summary / goals / functional_requirements が空でないことは、DRAFT 以外（APPROVED / SUPERSEDED）でのみ要求する。雛形は空の DRAFT として生成され、要件定義の対話で埋まっていくため。",
  "type": "object",
  "required": ["app_id", "app_name", "version", "status", "summary", "goals", "functional_requirements"],
  "additionalProperties": false,
  "properties": {
    "app_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "app_name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "SUPERSEDED"] },
    "summary": { "type": "string" },
    "goals": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "target_users": { "type": "array", "items": { "type": "string" } },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "priority", "acceptance_criteria"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^FR-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["MUST", "SHOULD", "COULD"] },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "description"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "approved_by": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "superseded_by": { "type": ["integer", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "APPROVED" } } },
      "then": {
        "required": ["approved_by", "approved_at"],
        "properties": { "approved_by": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["APPROVED", "SUPERSEDED"] } } },
      "then": {
        "properties": {
          "summary": { "minLength": 1 },
          "goals": { "minItems": 1 },
          "functional_requirements": { "minItems": 1 }
        }
      }
    }
  ]
}
