{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparness.local/schemas/feature-contract.schema.json",
  "title": "Feature Contract",
  "description": "apps/<app-id>/03-features/<feature-id>/contract.yaml の検証スキーマ。この機能の入出力の唯一の情報源。担当者はこのファイルと SPEC.md だけを見れば実装できる。",
  "type": "object",
  "required": [
    "feature_id",
    "feature_name",
    "version",
    "description",
    "inputs",
    "outputs",
    "tech_stack"
  ],
  "additionalProperties": false,
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "feature_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "json_schema",
          "required"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "json_schema": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "example": {}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "json_schema"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "json_schema": {
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "example": {}
        }
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "response_shape": {
            "type": "object"
          }
        }
      }
    },
    "tech_stack": {
      "type": "object",
      "required": [
        "language",
        "libraries"
      ],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "version",
              "license"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "検証コマンドの宣言（ハーネスは値を一切解釈せず、そのまま実行して終了コードだけを見る）。CONVENTIONS.md 12節。shared-kernel.yaml に全機能共通の宣言を置き、contract.yaml でキー単位に上書きできる。",
      "additionalProperties": false,
      "properties": {
        "working_dir": {
          "type": "string",
          "description": "コマンドを実行するディレクトリ（03-features/<feature-id>/ からの相対）。省略時は機能ディレクトリ直下。"
        },
        "test_command": {
          "type": "string",
          "description": "単体テストを実行するコマンド。TESTED にするには宣言が必須。"
        },
        "build_command": {
          "type": "string"
        },
        "typecheck_command": {
          "type": "string"
        },
        "lint_command": {
          "type": "string"
        },
        "junit_xml": {
          "type": "string",
          "description": "test_command が出力する JUnit XML のパス（working_dir からの相対）。宣言すると空振り検出・スキップ率・テスト識別子の照合が有効になる。出力できない技術なら宣言しなくてよい（終了コードによるゲートは効き続ける）。"
        },
        "max_skip_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "スキップされたテストの許容割合（既定 0.2）。junit_xml を宣言した場合のみ有効。"
        }
      }
    },
    "non_functional": {
      "type": "object"
    },
    "test_strategy": {
      "type": "object",
      "description": "テスト方針と、要件の受入基準 → テスト識別子の対応表。coverage[] に書いたテスト識別子は run_verification.py が JUnit XML と突合し、実在して成功したことを機械検証する（CONVENTIONS.md 14節）。",
      "required": [
        "approach",
        "coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "approach": {
          "type": "string",
          "description": "何をどう検証するかの方針（自由記述）。"
        },
        "coverage": {
          "type": "array",
          "description": "要件の acceptance_criteria ごとに、それを検証するテストの識別子を対応づける。",
          "items": {
            "type": "object",
            "required": [
              "requirement",
              "acceptance_criterion",
              "test_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "requirement": {
                "type": "string",
                "pattern": "^FR-[0-9]+$"
              },
              "acceptance_criterion": {
                "type": "string",
                "minLength": 1,
                "description": "requirements.machine.yaml の acceptance_criteria の該当項目（原文のまま書く）。"
              },
              "test_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "JUnit XML の <testcase> と照合される識別子。書式は言語・レポータごとに異なってよい（pytest なら tests/test_x.py::test_y、jest なら describe > it など）。"
              }
            }
          }
        }
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "open_issues": {
      "type": "array",
      "description": "凍結後に見つかった契約の穴の申し送り（追記のみ許可。既存の項目は変更・削除できない）。統合時に拾えるよう、SPEC.md ではなく契約側に残す。",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "found_at",
          "found_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OI-[0-9]+$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "found_at": {
            "type": "string",
            "format": "date-time"
          },
          "found_by": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "Blocker",
              "Major",
              "Minor"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
