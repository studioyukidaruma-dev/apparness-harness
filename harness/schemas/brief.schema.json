{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparness.local/schemas/brief.schema.json",
  "title": "Brief",
  "description": "アプリの要件定義に先立ってユーザーが記入する企画ブリーフ。briefs/<app-id>.brief.yaml と apps/<app-id>/00-requirements/brief.yaml を検証する。要件定義の入力であって承認物ではないため、必須項目は書式を成立させる最小限（brief_version）だけに留め、内容の充足は check_brief.py が『未記入項目』として報告する。記入者が記号を足し消ししなくて済むよう、空欄は『コロンの後に何もない』（null）で表し、各項目は null を許す（旧形式の \"\" と [] も引き続き空欄として有効）。",
  "type": "object",
  "required": ["brief_version"],
  "additionalProperties": false,
  "properties": {
    "brief_version": { "type": "integer", "minimum": 1 },
    "app_id": { "type": ["string", "null"], "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$" },
    "app_name": { "type": ["string", "null"] },
    "author": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"] },

    "purpose": { "type": ["string", "null"] },
    "background": { "type": ["string", "null"] },
    "target_users": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "goals": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "non_goals": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },

    "must_features": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": ["string", "null"] },
          "acceptance": { "type": ["string", "null"] }
        }
      }
    },
    "nice_to_have": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": ["string", "null"] }
        }
      }
    },

    "ui": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "form": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "references": { "type": ["array", "null"], "items": { "type": ["string", "null"] } }
      }
    },

    "tech": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "preferred": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
        "forbidden": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
        "reasons": { "type": ["string", "null"] },
        "existing_assets": { "type": ["string", "null"] }
      }
    },

    "data": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "handles": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
        "persistence": { "type": ["string", "null"] },
        "personal_information": { "type": ["string", "null"] },
        "volume": { "type": ["string", "null"] }
      }
    },

    "integrations": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": ["string", "null"] },
          "credentials": { "type": ["string", "null"] }
        }
      }
    },

    "environment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": ["string", "null"] },
        "deployment": { "type": ["string", "null"] },
        "offline": { "type": ["string", "null"] },
        "users_scale": { "type": ["string", "null"] }
      }
    },

    "non_functional_requirements": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["category", "description"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "constraints": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "acceptance_overall": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "autonomy_mode": { "type": ["string", "null"], "enum": ["", null, "MANUAL", "SUPERVISED", "AUTONOMOUS"] },
    "references": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "open_points": { "type": ["array", "null"], "items": { "type": ["string", "null"] } },
    "notes": { "type": ["string", "null"] }
  }
}
