{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apparness.local/schemas/status.schema.json",
  "title": "Feature Status",
  "description": "apps/<app-id>/03-features/<feature-id>/status.yaml の検証スキーマ。render_progress.py がこのファイル群を集約して PROGRESS.md / STATE.machine.yaml を生成する。",
  "type": "object",
  "required": [
    "feature_id",
    "app_id",
    "state",
    "last_updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "state": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "CONTRACT_DRAFTED",
        "CONTRACT_APPROVED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "TESTED",
        "INTEGRATED",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state",
          "at"
        ],
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "by": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verification_receipt": {
      "type": "object",
      "description": "harness/scripts/run_verification.py が生成する検証受領書。**手書き禁止**（Rule 10 が Edit/Write によるこのブロックの変更を拒否する）。state を TESTED にするには、宣言された全コマンドが exit_code 0 で、commit が現在の HEAD と一致している必要がある。",
      "required": [
        "commit"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 7,
          "description": "検証を実行した時点の HEAD。実装が進めば受領書は無効になる。"
        },
        "test": {
          "type": "object",
          "required": [
            "exit_code",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "build": {
          "type": "object",
          "required": [
            "exit_code",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "typecheck": {
          "type": "object",
          "required": [
            "exit_code",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "lint": {
          "type": "object",
          "required": [
            "exit_code",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "failures": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "traceability": {
          "type": "object",
          "description": "contract.yaml の test_strategy.coverage[].test_ids を JUnit XML と突合した結果。",
          "required": [
            "declared",
            "matched"
          ],
          "additionalProperties": false,
          "properties": {
            "declared": {
              "type": "integer",
              "minimum": 0,
              "description": "契約で宣言されたテスト識別子の数。"
            },
            "matched": {
              "type": "integer",
              "minimum": 0,
              "description": "JUnit XML 中に実在し、成功していた識別子の数。"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "JUnit XML に見つからなかった識別子。"
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "見つかったが成功していなかった識別子。"
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "description": "gate-reviewer subagent（独立レビューア）の審査結果。verdict は深刻度の集計から機械的に決まる（Blocker が 1 件以上なら NO-GO）。CONVENTIONS.md 10節。",
      "required": [
        "verdict",
        "at",
        "rounds"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "GO",
            "NO-GO",
            "ESCALATED"
          ],
          "description": "ESCALATED は 3 ラウンド収束せず人間の判断に委ねた状態。"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "description": "これまでに実施したレビューのラウンド数。"
        },
        "blockers": {
          "type": "integer",
          "minimum": 0
        },
        "majors": {
          "type": "integer",
          "minimum": 0
        },
        "minors": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
